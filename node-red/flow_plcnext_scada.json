    {
        "id": "fn_build_ui_cmd",
        "type": "function",
        "z": "tab_scada_ui",
        "name": "Empaquetar Comando + ID Único",
        "func": "const cmdId = \"ui_\" + Date.now() + \"_\" + Math.floor(Math.random() * 1000);\nconst payload = {\n    cmd_id: cmdId,\n    timestamp: new Date().toISOString(),\n    ttl_ms: 10000,\n    value: msg.payload\n};\n\nreturn [\n    { topic: msg.topic, qos: 1, retain: false, payload: payload },\n    { payload: \"Enviado (\" + cmdId + \") esperando ACK del PLC...\" }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 520,
        "wires": [
            [
                "mqtt_out_ui_cmd"
            ],
            [
                "ui_txt_ack"
            ]
        ]
    },
    {
        "id": "mqtt_out_ui_cmd",
        "type": "mqtt out",
        "z": "tab_scada_ui",
        "name": "Enviar Comando MQTT (QoS 1)",
        "topic": "",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt_broker_local",
        "x": 730,
