    {
        "id": "fn_mqtt_buffer",
        "type": "function",
        "z": "tab_mqtt_ctrl",
        "name": "Buffer Offline + Publicar MQTT",
        "func": "const mqttOk = global.get(\"mqtt_connected\") === true;\nlet buffer = flow.get(\"offline_buffer\") || [];\n\nif (!mqttOk) {\n    if (buffer.length >= 100) buffer.shift();\n    buffer.push({ topic: msg.topic, payload: msg.payload });\n    flow.set(\"offline_buffer\", buffer);\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"Buffered: \" + buffer.length });\n    return null;\n}\n\n// Si recuperó conexión y hay pendientes, vaciar en orden\nif (buffer.length > 0) {\n    for (const item of buffer) {\n        node.send({ topic: item.topic, payload: item.payload, qos: 0, retain: false });\n    }\n    flow.set(\"offline_buffer\", []);\n}\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"MQTT Online\" });\nmsg.qos = 0;\nmsg.retain = false;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
