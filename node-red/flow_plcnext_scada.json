    {
        "id": "fn_build_reads",
        "type": "function",
        "z": "tab_opcua_proc",
        "name": "Preparar lecturas OPC UA",
        "func": "// NOTA: Verificar los NodeId reales en UA Expert (Etapa 3/4) antes de desplegar en producción.\nconst prefix = \"ns=6;s=Arp.Plc.Eclr/MainInstance.\";\nconst tags = [\n    \"DI_Start\",\n    \"DI_Stop\",\n    \"AI_Sensor_Raw\",\n    \"AI_Sensor_Voltage\",\n    \"AI_Sensor_Percent\",\n    \"DO_Motor\",\n    \"DO_LED\",\n    \"SYS_PLC_Heartbeat\",\n    \"SYS_Gateway_Heartbeat\",\n    \"SYS_Communication_OK\",\n    \"SYS_Motor_Status\",\n    \"SYS_Alarm\",\n    \"SYS_Sensor_Valid\",\n    \"SYS_System_Ready\",\n    \"DIAG_Last_Error\"\n];\n\nfor (const tag of tags) {\n    node.send({\n        topic: prefix + tag,\n        tagName: tag,\n        action: \"read\"\n    });\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 80,
        "wires": [
            [
                "opcua_client_read"
            ]
        ]
    },
    {
        "id": "fn_gw_heartbeat",
        "type": "function",
        "z": "tab_opcua_proc",
        "name": "Incrementar Gateway Heartbeat",
        "func": "let hb = flow.get(\"gw_heartbeat\") || 0;\nhb = (hb + 1) % 4294967295;\nflow.set(\"gw_heartbeat\", hb);\nglobal.set(\"gw_heartbeat\", hb);\n\nmsg.topic = \"ns=6;s=Arp.Plc.Eclr/MainInstance.SYS_Gateway_Heartbeat\";\nmsg.datatype = \"UInt32\";\nmsg.payload = hb;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 160,
