    {
        "id": "fn_normalize_telemetry",
        "type": "function",
        "z": "tab_opcua_proc",
        "name": "Normalizar JSON Estándar + Cache",
        "func": "const cache = flow.get(\"plc_tags\") || {};\nconst tagName = msg.tagName || (msg.topic ? msg.topic.split(\".\").pop() : null);\nif (tagName) {\n    cache[tagName] = msg.payload;\n    flow.set(\"plc_tags\", cache);\n    flow.set(\"last_opcua_ok\", Date.now());\n    global.set(\"plc_state\", cache);\n}\n\n// Emitir paquete consolidado cuando llega SYS_PLC_Heartbeat\nif (tagName !== \"SYS_PLC_Heartbeat\") {\n    return null;\n}\n\nconst telemetry = {\n    device: \"AXC_F_2152\",\n    timestamp: new Date().toISOString(),\n    sensor: {\n        raw: Number(cache.AI_Sensor_Raw || 0),\n        voltage: Number((cache.AI_Sensor_Voltage || 0).toFixed(2)),\n        percentage: Number((cache.AI_Sensor_Percent || 0).toFixed(1)),\n        valid: Boolean(cache.SYS_Sensor_Valid)\n    },\n    inputs: {\n        start: Boolean(cache.DI_Start),\n        stop: Boolean(cache.DI_Stop)\n    },\n    outputs: {\n        motor: Boolean(cache.DO_Motor),\n        led: Boolean(cache.DO_LED)\n    },\n    system: {\n        communication_ok: Boolean(cache.SYS_Communication_OK),\n        alarm: Boolean(cache.SYS_Alarm),\n        ready: Boolean(cache.SYS_System_Ready),\n        heartbeat: Number(cache.SYS_PLC_Heartbeat || 0),\n        gateway_heartbeat: Number(global.get(\"gw_heartbeat\") || 0),\n        last_error: String(cache.DIAG_Last_Error || \"\")\n    }\n};\n\nreturn [\n    { topic: \"plcnext/axcf2152/telemetry\", payload: telemetry },\n    { payload: telemetry }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 80,
        "wires": [
            [
                "link_out_telemetry"
            ],
            [
                "link_out_ui_data"
            ]
        ]
