        "type": "function",
        "z": "tab_scada_ui",
        "name": "Distribuir a Paneles SCADA",
        "func": "const t = msg.payload;\nconst mqttOk = global.get(\"mqtt_connected\") === true;\n\nreturn [\n    { payload: t.system.communication_ok ? \"ONLINE\" : \"DESCONECTADO\" },\n    { payload: mqttOk ? \"CONECTADO\" : \"DESCONECTADO\" },\n    { payload: t.outputs.motor ? \"EN MARCHA\" : \"DETENIDO\" },\n    { payload: t.system.alarm ? \"ALARMA ACTIVA\" : \"NORMAL\" },\n    { payload: t.sensor.voltage },\n    { payload: t.sensor.percentage },\n    { payload: \"Start: \" + t.inputs.start + \" | Stop: \" + t.inputs.stop },\n    { payload: \"PLC HB: \" + t.system.heartbeat + \" | GW HB: \" + t.system.gateway_heartbeat },\n    { topic: \"Voltaje (V)\", payload: t.sensor.voltage },\n    { topic: \"Porcentaje (%)\", payload: t.sensor.percentage },\n    { topic: \"Motor (0/1)\", payload: t.outputs.motor ? 1 : 0 }\n];",
