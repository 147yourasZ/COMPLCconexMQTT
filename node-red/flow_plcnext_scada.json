    {
        "id": "fn_validate_cmd",
        "type": "function",
        "z": "tab_mqtt_ctrl",
        "name": "Validar Comando (ID único + TTL + Permisos)",
        "func": "const p = msg.payload;\nconst topicParts = (msg.topic || \"\").split(\"/\");\nconst cmdAction = topicParts[topicParts.length - 1];\nconst now = Date.now();\n\nfunction makeAck(status, reason) {\n    return {\n        topic: \"plcnext/axcf2152/ack\",\n        qos: 1,\n        retain: false,\n        payload: {\n            device: \"AXC_F_2152\",\n            cmd_id: (p && p.cmd_id) ? p.cmd_id : \"unknown\",\n            action: cmdAction,\n            status: status,\n            reason: reason,\n            timestamp: new Date().toISOString()\n        }\n    };\n}\n\nif (!p || typeof p !== \"object\" || !p.cmd_id) {\n    return [null, makeAck(\"rejected\", \"MISSING_CMD_ID_OR_JSON\")];\n}\n\n// 1. Control de expiración (TTL por defecto 10000 ms)\nconst ttl = Number(p.ttl_ms || 10000);\nconst ts = p.timestamp ? Date.parse(p.timestamp) : now;\nif (isNaN(ts) || (now - ts) > ttl) {\n    return [null, makeAck(\"rejected\", \"COMMAND_EXPIRED\")];\n}\n\n// 2. Evitar comandos duplicados\nlet seen = flow.get(\"seen_cmd_ids\") || [];\nif (seen.includes(p.cmd_id)) {\n    return [null, makeAck(\"rejected\", \"DUPLICATE_CMD_ID\")];\n}\nseen.push(p.cmd_id);\nif (seen.length > 100) seen.shift();\nflow.set(\"seen_cmd_ids\", seen);\n\n// 3. Mapeo a variables OPC UA\nconst map = {\n    \"motor_start\": { node: \"CMD_Motor_Start\", val: true },\n    \"motor_stop\":  { node: \"CMD_Motor_Stop\",  val: true },\n    \"led\":         { node: \"CMD_LED\",         val: Boolean(p.value) },\n    \"reset_alarm\": { node: \"CMD_Reset_Alarm\", val: true }\n};\n\nconst target = map[cmdAction];\nif (!target) {\n    return [null, makeAck(\"rejected\", \"UNKNOWN_COMMAND_TOPIC\")];\n}\n\n// 4. Verificación de permisos básicos para arranque\nconst plcState = global.get(\"plc_state\") || {};\nif (cmdAction === \"motor_start\" && plcState.SYS_Alarm) {\n    return [null, makeAck(\"rejected\", \"PLC_ALARM_ACTIVE\")];\n}\n\nconst opcMsg = {\n    topic: \"ns=6;s=Arp.Plc.Eclr/MainInstance.\" + target.node,\n    datatype: \"Boolean\",\n    payload: target.val,\n    cmd_meta: { cmd_id: p.cmd_id, action: cmdAction }\n};\n\nreturn [opcMsg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 200,
